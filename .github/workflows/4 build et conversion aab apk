name: 4 build et conversion aab apk

on:
  workflow_dispatch:
    inputs:
      build_type:
        description: "Type de build (debug ou release)"
        required: true
        default: "debug"
        type: choice
        options:
          - debug
          - release

jobs:
  build_android:
    runs-on: ubuntu-latest

    steps:
    - name: 🧩 Checkout repo
      uses: actions/checkout@v4

    - name: ▶️ Display selected build type
      run: |
        echo "Selected build type: ${{ github.event.inputs.build_type }}"
    # 🔐 RESTORE KEYSTORE FROM GITHUB SECRET
    - name: 🔐 Recreate keystore
      run: |
        echo "${{ secrets.KEYSTORE_FILE }}" | base64 --decode > release.keystore
    # 🔑 EXPORT SIGNING SECRETS
    - name: 🔑 Export signing secrets
      run: |
        echo "KEYSTORE_PASSWORD=${{ secrets.KEYSTORE_PASSWORD }}" >> $GITHUB_ENV
        echo "KEY_ALIAS=${{ secrets.KEY_ALIAS }}" >> $GITHUB_ENV
        echo "KEY_ALIAS_PASSWORD=${{ secrets.KEY_ALIAS_PASSWORD }}" >> $GITHUB_ENV
    # -----------------------------------------
    # CACHE PIP
    # -----------------------------------------
    - name: ♻️ Cache pip
      uses: actions/cache@v4
      with:
        path: ~/.cache/pip
        key: pip-${{ runner.os }}-${{ hashFiles('**/requirements.txt') }}
        restore-keys: pip-${{ runner.os }}-

    # -----------------------------------------
    # CACHE ANDROID SDK
    # -----------------------------------------
    - name: ♻️ Cache Android SDK
      id: cache-android
      uses: actions/cache@v4
      with:
        path: |
          ~/Android/platforms
          ~/Android/build-tools
          ~/Android/platform-tools
          ~/Android/ndk
        key: android-sdk-${{ runner.os }}-v1
        restore-keys: android-sdk-${{ runner.os }}-

    # -----------------------------------------
    # CACHE BUILDOZER
    # -----------------------------------------
    - name: ♻️ Cache Buildozer directory
      uses: actions/cache@v4
      with:
        path: ~/.buildozer
        key: buildozer-${{ runner.os }}-v1
        restore-keys: buildozer-${{ runner.os }}-

    # -----------------------------------------
    # CACHE GRADLE
    # -----------------------------------------
    - name: ♻️ Cache Gradle
      uses: actions/cache@v4
      with:
        path: |
          ~/.gradle/caches
          ~/.gradle/wrapper
        key: gradle-${{ runner.os }}-v1
        restore-keys: gradle-${{ runner.os }}-

    # -----------------------------------------
    # CACHE NDK
    # -----------------------------------------
    - name: ♻️ Cache NDK
      uses: actions/cache@v4
      with:
        path: $HOME/.android/ndk
        key: ndk-${{ runner.os }}-v1
        restore-keys: ndk-${{ runner.os }}-

    - name: 🐍 Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: 📦 Install system dependencies
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential libltdl-dev zip unzip openjdk-17-jdk python3-pip \
          libncurses-dev libtool libtool-bin automake autoconf pkg-config m4
    - name: 🔧 Install Buildozer
      run: |
        python -m pip install --upgrade pip setuptools cython==0.29.33
        pip install buildozer
    # -----------------------------------------
    # INSTALL SDK ONLY IF CACHE DIDN'T RESTORE
    # -----------------------------------------
    - name: 📱 Install Android SDK + Build tools (only if needed)
      if: steps.cache-android.outputs.cache-hit != 'true'
      run: |
        mkdir -p $HOME/Android/cmdline-tools
        wget https://dl.google.com/android/repository/commandlinetools-linux-9123335_latest.zip -O commandlinetools.zip
        unzip commandlinetools.zip -d $HOME/Android/cmdline-tools
        yes | $HOME/Android/cmdline-tools/cmdline-tools/bin/sdkmanager --sdk_root=$HOME/Android --licenses
        $HOME/Android/cmdline-tools/cmdline-tools/bin/sdkmanager \
          "platform-tools" \
          "platforms;android-33" \
          "build-tools;33.0.2" \
          "ndk;25.2.9519653"
    - name: Install apktool
      run: |
        sudo apt-get install -y apktool
    - name: 🔧 Configure Android env
      run: |
        echo "ANDROID_SDK_ROOT=$HOME/Android" >> $GITHUB_ENV
        echo "PATH=$HOME/Android/cmdline-tools/cmdline-tools/bin:$HOME/Android/platform-tools:$PATH" >> $GITHUB_ENV
    # -----------------------------------------
    # BUILD APK / AAB
    # -----------------------------------------
    - name: 🏗️ Build APK with Buildozer
      run: |
        if [ "${{ github.event.inputs.build_type }}" = "release" ]; then
          echo "Building RELEASE..."
          buildozer --verbose android release
        else
          echo "Building DEBUG..."
          buildozer --verbose android debug
        fi

    - name: 📦 Download bundletool
      if: ${{ github.event.inputs.build_type == 'release' }}
      run: |
        wget https://github.com/google/bundletool/releases/download/1.14.0/bundletool-all-1.14.0.jar -O bundletool.jar

    - name: 🔄 Convert AAB to universal APK
      if: ${{ github.event.inputs.build_type == 'release' }}
      run: |
        java -jar bundletool.jar build-apks \
          --bundle=bin/*-release.aab \
          --output=bin/app.apks \
          --mode=universal \
          --ks=release.keystore \
          --ks-pass=pass:$KEYSTORE_PASSWORD \
          --key-pass=pass:$KEY_ALIAS_PASSWORD \
          --ks-key-alias=$KEY_ALIAS

        unzip -o bin/app.apks -d bin/apks
        
    - name: 🔍 List build outputs
      run: |
        echo "📁 Contenu du dossier bin :"
        ls -lh ./bin
        
    - name: 📤 Upload APK / AAB
      uses: actions/upload-artifact@v4
      with:
        name: mon-budget-${{ github.event.inputs.build_type }}
        path: |
          ./bin/*${{ github.event.inputs.build_type }}*.apk
          ./bin/apks/universal.apk
          ./bin/*${{ github.event.inputs.build_type }}*.aab
          ./bin/*unsigned*.apk
